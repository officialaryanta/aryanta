    })();
  </script>
  <style>
    :root {
      color-scheme: light;
      --bg: #f7f8fc;
      --surface: rgba(255,255,255,.76);
      --text: #171923;
      --muted: #73798a;
      --line: rgba(30,40,70,.10);
      --accent: #635bff;
      --accent2: #00b9c7;
      --glow: rgba(99,91,255,.18);
      --grid: rgba(90,100,140,.065);
    }
    :root[data-theme="dark"] {
      color-scheme: dark;
      --bg: #080a10;
      --surface: rgba(20,23,34,.78);
      --text: #f5f6ff;
      --muted: #9da4b8;
      --line: rgba(255,255,255,.10);
      --accent: #918aff;
      --accent2: #38d9e8;
      --glow: rgba(112,99,255,.20);
      --grid: rgba(190,200,255,.045);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      min-height: 100vh;
      min-height: 100svh;
      font-family: Inter, -apple-system, BlinkMacSystemFont,
        "Segoe UI", sans-serif;
      background: var(--bg);
      color: var(--text);
      overflow-x: hidden;
      transition: background .4s, color .4s;
    }
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -2;
      pointer-events: none;
      background-image:
        linear-gradient(var(--grid) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid) 1px, transparent 1px);
      background-size: 42px 42px;
      mask-image: linear-gradient(to bottom, black, transparent 90%);
    }
    .orb {
      position: fixed;
      z-index: -1;
      width: 340px;
      height: 340px;
      border-radius: 50%;
      filter: blur(95px);
      opacity: .55;
      pointer-events: none;
      animation: drift 12s ease-in-out infinite alternate;
    }
    .orb.one {
      top: -170px;
      left: -100px;
      background: var(--glow);
    }
    .orb.two {
      bottom: -180px;
      right: -100px;
      background: rgba(0,185,199,.12);
      animation-delay: -5s;
    }
    header {
      width: min(1120px, 100%);
      margin: auto;
      padding: 25px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      animation: fadeDown .8s both;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
      font-size: 21px;
      font-weight: 800;
      letter-spacing: -.8px;
    }
    .brand img {
      width: 42px;
      height: 42px;
      object-fit: cover;
      border-radius: 13px;
      box-shadow: 0 4px 20px var(--glow);
    }
    .brand span { color: var(--accent); }
    .status {
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 9px 13px;
      border: 1px solid var(--line);
      background: var(--surface);
      border-radius: 50px;
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1px;
      backdrop-filter: blur(15px);
    }
    .dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #22c987;
      box-shadow: 0 0 12px #22c987;
      animation: blink 1.8s infinite;
    }
    main {
      min-height: calc(100svh - 145px);
      width: min(900px, 100%);
      margin: auto;
      padding: 40px 24px 55px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }
    .hero-image {
      position: relative;
      width: 126px;
      height: 126px;
      margin-bottom: 32px;
      animation: fadeUp .9s .1s both;
    }
    .hero-image::before,
    .hero-image::after {
      content: "";
      position: absolute;
      inset: -12px;
      border: 1px solid var(--line);
      border-radius: 34px;
      animation: rotate 16s linear infinite;
    }
    .hero-image::after {
      inset: -22px;
      border-style: dashed;
      opacity: .65;
      animation-direction: reverse;
      animation-duration: 28s;
    }
    .hero-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 27px;
      position: relative;
      z-index: 1;
      box-shadow: 0 15px 65px var(--glow);
      animation: float 4s ease-in-out infinite;
    }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 9px 15px;
      border: 1px solid var(--line);
      background: var(--surface);
      color: var(--accent);
      border-radius: 50px;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 2px;
      text-transform: uppercase;
      animation: fadeUp .8s .2s both;
    }
    h1 {
      margin: 26px 0 17px;
      font-size: clamp(43px, 8.5vw, 82px);
      line-height: 1.02;
      letter-spacing: -4px;
      font-weight: 850;
      animation: fadeUp .9s .3s both;
    }
    h1 .gradient {
      display: block;
      padding-bottom: 8px;
      background: linear-gradient(
        100deg, var(--accent), #9b72ff 48%, var(--accent2)
      );
      background-size: 200% auto;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation: shine 5s linear infinite;
    }
    .description {
      max-width: 510px;
      margin: 0 auto;
      color: var(--muted);
      font-size: clamp(14px, 2.5vw, 17px);
      line-height: 1.85;
      animation: fadeUp .9s .4s both;
    }
    .progress-card {
      width: min(380px, 100%);
      margin-top: 34px;
      padding: 18px 20px;
      border: 1px solid var(--line);
      border-radius: 17px;
      background: var(--surface);
      backdrop-filter: blur(18px);
      animation: fadeUp .9s .5s both;
    }
    .progress-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 13px;
      font-size: 12px;
      font-weight: 700;
    }
    .progress-top span:last-child {
      color: var(--muted);
      font-weight: 500;
    }
    .track {
      height: 5px;
      border-radius: 20px;
      overflow: hidden;
      background: var(--line);
    }
    .bar {
      width: 38%;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, var(--accent), var(--accent2));
      animation: loading 2.4s ease-in-out infinite alternate;
      box-shadow: 0 0 16px var(--glow);
    }
    .note {
      margin-top: 12px;
      color: var(--muted);
      font-size: 11px;
      letter-spacing: .2px;
    }
    .bottom-message {
      margin-top: 28px;
      color: var(--muted);
      font-size: 12px;
      animation: fadeUp 1s .6s both;
    }
    .bottom-message strong {
      color: var(--text);
      font-weight: 700;
    }
    /* Support button */
    .footer-actions {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 28px;
      animation: fadeUp 1s .65s both;
    }
    .action-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      min-height: 46px;
      padding: 0 18px;
      border: 1px solid var(--line);
      border-radius: 14px;
      color: var(--text);
      background: var(--surface);
      font: inherit;
      font-size: 12px;
      font-weight: 750;
      text-decoration: none;
      cursor: pointer;
      backdrop-filter: blur(15px);
      transition: transform .2s, border-color .2s, box-shadow .2s;
    }
    .action-button:hover {
      transform: translateY(-3px);
      border-color: var(--accent);
      box-shadow: 0 9px 28px var(--glow);
    }
    .action-button.primary {
      color: #fff;
      border-color: transparent;
      background: linear-gradient(110deg, #635bff, #8974ff);
      box-shadow: 0 8px 24px rgba(99,91,255,.2);
    }
    .action-button svg {
      width: 17px;
      height: 17px;
      flex-shrink: 0;
    }
    .follow-label {
      margin-top: 25px;
      color: var(--muted);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 2px;
      text-transform: uppercase;
    }
    .social-links {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-top: 13px;
    }
    .social-link {
      display: grid;
      width: 43px;
      height: 43px;
      place-items: center;
      border: 1px solid var(--line);
      border-radius: 14px;
      color: var(--text);
      background: var(--surface);
      text-decoration: none;
      cursor: pointer;
      transition: transform .2s, color .2s, border-color .2s;
    }
    .social-link:hover {
      transform: translateY(-4px);
      color: var(--accent);
      border-color: var(--accent);
    }
    .social-link svg {
      width: 19px;
      height: 19px;
    }
    footer {
      width: min(1120px, 100%);
      margin: auto;
      padding: 20px 25px 26px;
      border-top: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      color: var(--muted);
      font-size: 11px;
    }
    footer .domain {
      color: var(--text);
      font-weight: 700;
      letter-spacing: .5px;
    }
    /* Custom support/social popup */
    .support-overlay {
      position: fixed;
      inset: 0;
      z-index: 1000;
      display: grid;
      place-items: center;
      padding: 20px;
      background: rgba(5,8,20,.56);
      backdrop-filter: blur(9px);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity .25s, visibility .25s;
    }
    .support-overlay.open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }
    .support-popup {
      position: relative;
      width: min(420px, 100%);
      padding: 30px 24px 24px;
      border: 1px solid var(--line);
      border-radius: 25px;
      color: var(--text);
      background: var(--bg);
      box-shadow: 0 25px 90px rgba(0,0,0,.25);
      transform: translateY(15px) scale(.97);
      transition: transform .25s ease;
      text-align: left;
    }
    .support-overlay.open .support-popup {
      transform: translateY(0) scale(1);
    }
    .support-close {
      position: absolute;
      top: 14px;
      right: 14px;
      width: 36px;
      height: 36px;
      display: grid;
      place-items: center;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--surface);
      color: var(--text);
      cursor: pointer;
      font-size: 23px;
    }
    .support-symbol {
      display: grid;
      place-items: center;
      width: 55px;
      height: 55px;
      margin-bottom: 18px;
      border-radius: 17px;
      color: var(--accent);
      background: var(--glow);
      font-size: 25px;
    }
    .support-popup h2 {
      margin: 0 0 9px;
      font-size: 25px;
      letter-spacing: -.7px;
    }
    .support-popup > p {
      margin: 0 0 22px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.7;
    }
    .support-detail {
      display: flex;
      align-items: center;
      gap: 13px;
      padding: 15px;
      margin-top: 11px;
      border: 1px solid var(--line);
      border-radius: 15px;
      background: var(--surface);
      overflow-wrap: anywhere;
    }
    .support-detail-icon {
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      flex-shrink: 0;
      border-radius: 12px;
      background: var(--glow);
      color: var(--accent);
    }
    .support-detail-icon svg {
      width: 19px;
      height: 19px;
    }
    .support-detail small {
      display: block;
      margin-bottom: 4px;
      color: var(--muted);
      font-size: 10px;
    }
    .support-detail a {
      color: var(--text);
      font-size: 13px;
      font-weight: 750;
      text-decoration: none;
      overflow-wrap: anywhere;
    }
    .support-detail a:hover { color: var(--accent); }
    .support-popup .support-note {
      margin-top: 18px;
      margin-bottom: 0;
      text-align: center;
      font-size: 11px;
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeDown {
      from { opacity: 0; transform: translateY(-15px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-9px); }
    }
    @keyframes rotate { to { transform: rotate(360deg); } }
    @keyframes shine { to { background-position: 200% center; } }
    @keyframes blink { 50% { opacity: .35; } }
    @keyframes loading {
      from { width: 24%; }
      to { width: 76%; }
    }
    @keyframes drift {
      to { transform: translate(50px, 35px) scale(1.15); }
    }
    @media (max-width: 480px) {
      header { padding: 19px 17px; }
      .brand { font-size: 19px; }
      .brand img { width: 36px; height: 36px; }
      .status { padding: 8px 10px; font-size: 9px; }
      main { padding: 35px 20px 48px; }
      .hero-image { width: 105px; height: 105px; margin-bottom: 29px; }
      h1 { letter-spacing: -2.5px; }
      footer { padding: 18px 17px; font-size: 10px; }
      .footer-actions { gap: 9px; }
      .action-button { padding: 0 14px; }
      .support-popup { padding: 27px 18px 20px; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>
<body>
<div class="app">
<header>
 <div class="logo">◆ ARYANTA</div>
 <div>
  <button class="nav" onclick="showPage('home')">Pay</button>
  <button class="nav" onclick="showHistory()">History</button>
 </div>
</header>
<!-- PAYMENT PAGE -->
<section id="home" class="page active">
<div class="card">
 <div style="color:#62e6d5;font-size:11px;letter-spacing:2px">SECURE CHECKOUT</div>
 <h1>Make a payment.</h1>
 <p class="muted">Enter your amount and continue with Razorpay secure checkout.</p>
 <label>PAYMENT AMOUNT</label>
 <div class="amount">
  <span>₹</span>
  <input id="amount" type="number" min="1" max="500000" step="0.01" placeholder="0.00">
 </div>
 <div class="quick">
  <button onclick="setAmount(99)">₹99</button>
  <button onclick="setAmount(199)">₹199</button>
  <button onclick="setAmount(499)">₹499</button>
  <button onclick="setAmount(999)">₹999</button>
 </div>
 <button class="pay" id="payButton" onclick="startPayment()">Pay securely ↗</button>
 <div id="status" class="status"></div>
 <p class="muted" style="text-align:center;margin-top:20px">UPI · Cards · Netbanking</p>
</div>
</section>
<!-- HISTORY PAGE -->
<section id="history" class="page">
 <div class="card">
  <h1>Transaction History</h1>
  <p class="muted">Your recent payment attempts.</p>
  <div id="historyList"></div>
 </div>
</section>
<!-- INVOICE PAGE -->
<section id="invoice" class="page">
 <div class="card">
  <div style="display:flex;justify-content:space-between">
   <h2>ARYANTA</h2>
   <span class="muted">PAYMENT INVOICE</span>
  </div>
  <div id="invoiceDetails"></div>
  <div class="total" id="invoiceAmount"></div>
  <p class="muted" id="invoiceNote"></p>
  <div class="invoice-buttons no-print">
   <button class="nav" onclick="window.print()">Print / Save PDF</button>
   <button class="nav" onclick="showHistory()">History</button>
  </div>
 </div>
</section>
</div>
<script>
/*
 IMPORTANT:
 Replace with your Razorpay public Key ID.
 Never put your Razorpay Key Secret in HTML.
*/
const RAZORPAY_KEY_ID="rzp_live_SngTCp9tiWTd4h";
const STORAGE="aryanta_transactions";
let selectedInvoice=null;
function getTransactions(){
 try{return JSON.parse(localStorage.getItem(STORAGE)||"[]")}
 catch{return []}
}
function saveTransactions(data){
 localStorage.setItem(STORAGE,JSON.stringify(data));
}
function setAmount(value){
 document.getElementById("amount").value=value;
}
function money(value){
 return new Intl.NumberFormat("en-IN",{
  style:"currency",currency:"INR"
 }).format(value);
}
function escapeHTML(value){
 return String(value??"").replace(/[&<>"']/g,c=>({
  "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
 }[c]));
}
function invoiceNumber(){
 return String(Math.floor(1000000+Math.random()*9000000));
}
function showPage(id){
 document.querySelectorAll(".page").forEach(p=>{
  p.classList.remove("active");
 });
 document.getElementById(id).classList.add("active");
}
function updateTransaction(invoiceId,changes){
 let list=getTransactions();
let index=list.findIndex(t=>t.invoice===invoiceId);
if(index!==-1){
  list[index]={...list[index],...changes};
  saveTransactions(list);
}
}
function startPayment(){
 const amount=Number(document.getElementById("amount").value);
 const status=document.getElementById("status");
 const payButton=document.getElementById("payButton");
 if(!Number.isFinite(amount)||amount<1||amount>500000){
  status.className="status failed";
  status.textContent="Enter an amount between ₹1 and ₹5,00,000.";
  return;
 }
 if(!window.Razorpay){
  status.className="status failed";
  status.textContent="Razorpay could not load. Check your internet.";
  return;
 }
 const invoice=invoiceNumber();
 const record={
  invoice:invoice,
  amount:amount,
  date:new Date().toISOString(),
  status:"Pending",
  paymentId:"",
  method:"",
  utr:"",
  error:""
 };
 let list=getTransactions();
 list.unshift(record);
 saveTransactions(list);
 payButton.disabled=true;
 payButton.textContent="Opening Razorpay...";
 const options={
  key:RAZORPAY_KEY_ID,
  amount:String(Math.round(amount*100)),
  currency:"INR",
  name:"Aryanta",
  description:"Aryanta Payment",
  theme:{color:"#62e6d5"},
  handler:function(response){
   updateTransaction(invoice,{
    status:"Success response received",
    paymentId:response.razorpay_payment_id||""
   });
   status.className="status success";
   status.textContent="Payment success response received! Open History to view your invoice. Final captured status needs server verification.";
   payButton.disabled=false;
   payButton.textContent="Pay securely ↗";
  },
  modal:{
   ondismiss:function(){
    updateTransaction(invoice,{
     status:"Pending",
     error:"Checkout closed. Payment status unconfirmed."
    });
    payButton.disabled=false;
    payButton.textContent="Pay securely ↗";
   }
  }
 };
 try{
  const checkout=new Razorpay(options);
  checkout.on("payment.failed",function(response){
   const e=response.error||{};
   updateTransaction(invoice,{
    status:"Failed",
    paymentId:e.metadata?.payment_id||"",
    method:e.method||"",
    error:e.description||"Payment failed"
   });
   status.className="status failed";
   status.textContent="Payment failed. Failure information saved in history.";
   payButton.disabled=false;
   payButton.textContent="Pay securely ↗";
  });
  checkout.open();
 }catch(error){
  updateTransaction(invoice,{
   status:"Failed",
   error:"Could not open Razorpay Checkout"
  });
  status.className="status failed";
  status.textContent="Unable to open Razorpay.";
  payButton.disabled=false;
  payButton.textContent="Pay securely ↗";
 }
}
function showHistory(){
 const list=getTransactions();
 const container=document.getElementById("historyList");
 if(!list.length){
  container.innerHTML="<p class='muted'>No transactions yet.</p>";
 }else{
  container.innerHTML=list.map(t=>`
   <button class="transaction" onclick="openInvoice('${escapeHTML(t.invoice)}')">
    <div>
     <b>Invoice #${escapeHTML(t.invoice)}</b>
     <div class="small">${escapeHTML(new Date(t.date).toLocaleString("en-IN"))}</div>
     <b>${money(t.amount)}</b>
     <div class="small">${escapeHTML(t.status)}</div>
    </div>
   </button>
  `).join("");
 }
 showPage("history");
}
function openInvoice(invoice){
 const t=getTransactions().find(x=>x.invoice===invoice);
 if(!t)return;
 selectedInvoice=invoice;
 const details=[
  ["Invoice ID",t.invoice],
  ["Date & Time",new Date(t.date).toLocaleString("en-IN")],
  ["Payment Status",t.status],
  ["Payment Method",t.method||"Not supplied by HTML checkout"],
  ["UTR / Bank Reference",t.utr||"Not available"],
  ["Razorpay Payment ID",t.paymentId||"Not available"],
  ["Failure Information",t.error||"None"]
 ];
 document.getElementById("invoiceDetails").innerHTML=details.map(row=>`
  <div class="invoice-row">
   <span>${escapeHTML(row[0])}</span>
   <b>${escapeHTML(row[1])}</b>
  </div>
 `).join("");

 document.getElementById("invoiceAmount").textContent=money(t.amount);

 document.getElementById("invoiceNote").textContent=
  t.status==="Success response received"
  ?"Razorpay returned a successful checkout response. Captured status must be verified through Razorpay Dashboard or a secure server."
  :t.status==="Failed"
  ?"This payment attempt failed. See failure information above."
  :"Payment status is unconfirmed. Check Razorpay Dashboard before confirming receipt.";

 showPage("invoice");
}
</script>
