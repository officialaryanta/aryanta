
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Aryanta Payment Gateway</title>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<style>
*{box-sizing:border-box}
body{
 margin:0;padding:20px;min-height:100vh;
 background:radial-gradient(circle at top,#173c55,#080d19 65%);
 color:#fff;font-family:Arial,sans-serif
}
.app{max-width:650px;margin:auto;animation:show .5s}
@keyframes show{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:translateY(0)}}
header{display:flex;justify-content:space-between;align-items:center;margin-bottom:25px}
.logo{font-size:23px;font-weight:bold;color:#62e6d5}
button{cursor:pointer}
.nav{background:#18283d;border:1px solid #34445b;color:white;padding:11px 15px;border-radius:10px}
.card{background:#111c30;border:1px solid #293951;border-radius:22px;padding:25px;margin-bottom:15px}
h1{font-size:29px}
.muted{color:#91a0b8;font-size:13px;line-height:1.6}
label{display:block;margin:22px 0 9px;font-size:12px;color:#b9c9da}
.amount{display:flex;align-items:center;background:#091322;border:1px solid #34445b;border-radius:13px;padding:15px}
.amount span{font-size:25px;color:#62e6d5;margin-right:10px}
input{background:none;border:0;outline:none;color:white;font-size:27px;width:100%}
.quick{display:flex;gap:8px;margin:12px 0 20px;flex-wrap:wrap}
.quick button{background:#1b2a40;border:1px solid #34445b;color:white;padding:9px 13px;border-radius:9px}
.quick button:hover{border-color:#62e6d5;color:#62e6d5}
.pay{width:100%;padding:17px;border:0;border-radius:12px;background:linear-gradient(100deg,#62e6d5,#83d8ff);font-weight:bold;font-size:15px;color:#071521}
.pay:disabled{opacity:.5}
.status{display:none;padding:14px;margin-top:15px;border-radius:10px;font-size:13px;line-height:1.6}
.success{display:block;background:#16452f;color:#a4f5d0}
.failed{display:block;background:#4a2029;color:#ffb2b8}
.pending{display:block;background:#493b1b;color:#ffe0a0}
.transaction{width:100%;display:flex;justify-content:space-between;align-items:center;text-align:left;background:#101d31;color:white;border:1px solid #293951;padding:16px;border-radius:13px;margin:9px 0;animation:show .3s}
.transaction:hover{border-color:#62e6d5}
.small{font-size:11px;color:#91a0b8;margin-top:6px}
.invoice-row{display:flex;justify-content:space-between;gap:12px;padding:13px 0;border-bottom:1px solid #293951;font-size:13px}
.invoice-row span{color:#91a0b8}
.invoice-row b{text-align:right;overflow-wrap:anywhere}
.total{font-size:26px;color:#62e6d5;font-weight:bold;text-align:right;margin-top:20px}
.invoice-buttons{display:flex;gap:10px;margin-top:20px}
.invoice-buttons button{flex:1}
.page{display:none}
.page.active{display:block;animation:show .3s}
@media print{
 body{background:white;color:black}
 header,.no-print{display:none!important}
 .card{background:white;color:black;border:0}
 .invoice-row span,.small{color:#555}
}
</style>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
